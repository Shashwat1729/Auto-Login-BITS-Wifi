{
  "manifest_version": 3,
  "name": "BITS WiFi Auto Login",
  "version": "2.0",
  "description": "Automatically logs in to BITS WiFi network with improved reliability and user experience",
  "icons": {
    "16": "icons/icon256.png",
    "48": "icons/icon256.png",
    "128": "icons/icon256.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://172.16.0.30:8090/*",
    "http://172.16.100.117/*",
    "http://1.1.1.1/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon256.png"
    }
  },
  "options_page": "options.html",
  "author": "BITS Wifi Team",
  "homepage_url": "https://github.com/Shashwat1729/bitswifi-extension",
  "web_accessible_resources": [{
    "resources": [
      "icons/*.png"
    ],
    "matches": ["<all_urls>"]
  }]
}
